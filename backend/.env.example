# Copie para .env e preencha. O .env nunca vai para o Git.

# Supabase → Connect → "Session pooler" (porta 5432). Troque [SENHA] pela senha do banco.
DATABASE_URL=postgresql://postgres.gbeyjywogsdvxpcsvmtl:[SENHA]@aws-1-ca-central-1.pooler.supabase.com:5432/postgres

# Gere com: bun -e 'console.log(crypto.randomUUID()+crypto.randomUUID())'
JWT_SECRET=

PORT=3333
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./uploads

# Senha dos usuários de demonstração criados pelo seed (admin/cliente/compras @encantos.test)
SEED_PASSWORD=

# Painel admin sem login (só desenvolvimento). Em produção mantenha false.
ADMIN_AUTH_DISABLED=false

# Fotos dos produtos no Supabase Storage (bucket "produtos", criado pela migração 0003).
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...). Nunca use no frontend.
SUPABASE_SECRET_KEY=

# Robô vendedor com IA no WhatsApp (Claude). Chave em console.anthropic.com → API Keys.
# Vazio = robô de regras (menus numerados). Se a IA falhar numa mensagem, o robô de regras responde.
ANTHROPIC_API_KEY=
# Modelo e esforço de raciocínio (low é mais rápido e barato; high pensa mais).
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# Desliga a IA sem apagar a chave.
AI_ENABLED=true

# ---------- Pagamentos ----------
# O provedor ativo, a chave Pix da loja e os prazos são escolhidos no painel (Pedidos → Pagamentos).
# Aqui ficam só as credenciais. Sem elas, o "Pix copia e cola da loja" funciona com a chave Pix do painel.

# Endereço público da API, para os provedores avisarem pagamentos na hora (ex.: https://loja.com.br/api).
# Sem ele, o sistema consulta as cobranças a cada minuto (bom para testes).
PUBLIC_API_URL=

# Mercado Pago → Suas integrações → Credenciais → Access Token (TEST-... para testes).
MP_ACCESS_TOKEN=

# Asaas → Integrações → Chave de API. Sandbox: conta em sandbox.asaas.com. O Asaas exige o CPF do cliente.
ASAAS_API_KEY=
ASAAS_SANDBOX=true
# Token que você define ao cadastrar o webhook no Asaas (32+ caracteres).
ASAAS_WEBHOOK_TOKEN=

# Efí → API → Aplicações: Client ID/Secret e certificado. Converta o .p12 para .pem:
#   openssl pkcs12 -in certificado.p12 -out certificado.pem -nodes -password pass:""
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_PATH=
EFI_KEY_PATH=
EFI_PIX_KEY=
EFI_SANDBOX=true
